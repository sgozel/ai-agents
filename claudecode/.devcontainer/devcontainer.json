{
  "name": "claude-code-devcontainer",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  // map host UID -> same UID in the container (rootless podman), so files on the mount stay the user's files
  "runArgs": ["--userns=keep-id"],
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  // forbid VS Code to forward the ssh agent inside the container, and set the container time to Swiss time
  "remoteEnv": {
    "SSH_AUTH_SOCK": "",
    "TZ": "Europe/Zurich"
  },
  // VS Code extensions installed inside the container
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "mhutchie.git-graph",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ],
      // container-side Python environment
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python"
      }
    }
  },
  // create mounts:
  "mounts": [
    // volume for persistence of Claude settings
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
    // other mounts
    // "source=${localEnv:HOME}/<source>,target=${containerWorkspaceFolder}/<destination>,type=bind"

  ],
  // create bind-mount targets on the host first, so they are owned by user UID, not by container root
  //"initializeCommand": "cd '${localWorkspaceFolder}' && mkdir -p target1 target2 ...",
  // keep ~/.claude.json inside the persisted volume
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // container's single uv venv, kept out of the host-shared folder
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
  },
  // additional installations at container build time
  "postCreateCommand": "bash .devcontainer/postCreate.sh"
}
