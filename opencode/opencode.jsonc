{
    "$schema": "https://opencode.ai/config.json",
    // start in plan mode instead of build mode
    "default_agent": "plan",
    "permission": {
        "bash": {
            // later rules win, so keep any catch-all "*" rule above these
            "git commit": "deny",
            "git commit *": "deny",
            "git push": "deny",
            "git push *": "deny"
        }
    },
    "model": "cscs/zai-org/GLM-5.3-Flash",
    "provider": {
        "cscs": {
            "npm": "@ai-sdk/anthropic",
            "name": "CSCS Internal Inference",
            "options": {
                "baseURL": "https://api.inference.cscs.ch/v1",
                "systemMessageMode": "system"
            },
            "models": {
                "zai-org/GLM-5.3": {
                    "name": "GLM 5.3",
                    "limit": {
                        "context": 1048576,
                        "output": 16384
                    }
                },
                "zai-org/GLM-5.3-Flash": {
                    "name": "GLM 5.3 Flash",
                    "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 1048576,
                        "output": 16384
                    }
                },
                "Qwen/Qwen3.8-27B-FP8": {
                    "name": "Qwen 3.8 27B",
                    "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 16384
                    }
                },
                "Qwen/Qwen3.8-Flash-Next-FP8": {
                    "name": "Qwen 3.8 Flash Next",
                    "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 16384
                    }
                },
                "swiss-ai/Apertus-v1.5-70B": {
                    "name": "Apertus v1.5 70B",
		            "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 16384
                    }
                },
                "swiss-ai/Apertus-v1.5-70B-thinking": {
                    "name": "Apertus v1.5 70B (thinking)",
		            "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 16384
                    }
                },
                "swiss-ai/Apertus-v1.5-8B": {
                    "name": "Apertus v1.5 8B",
		            "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 16384
                    }
                },
                "swiss-ai/Apertus-v1.5-8B-thinking": {
                    "name": "Apertus v1.5 8B (thinking)",
		            "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 16384
                    }
                }
            } // models
        } // cscs
    } // provider
}
